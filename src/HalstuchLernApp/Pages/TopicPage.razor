@page "/topic/{categoryId}/{topicId}"
@inject ContentService ContentService

@if (_topic == null || _category == null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    <PageTitle>@_topic.Title – HalstuchLernApp</PageTitle>

    <MudButton Href="@($"category/{CategoryId}")" Variant="Variant.Text" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-4">
        Zurück zu @_category.Title
    </MudButton>

    <MudText Typo="Typo.h4" Class="mb-1">@_topic.Title</MudText>
    @if (!string.IsNullOrEmpty(_topic.Subtitle))
    {
        <MudText Typo="Typo.subtitle1" Class="mb-4 mud-text-secondary">@_topic.Subtitle</MudText>
    }

    @if (!string.IsNullOrEmpty(_topic.Intro))
    {
        <MudText Typo="Typo.body1" Class="mb-4">@_topic.Intro</MudText>
    }

    @if (!string.IsNullOrEmpty(_topic.Content))
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            @foreach (var line in _topic.Content.Split('\n'))
            {
                <MudText Typo="Typo.body1">@line</MudText>
            }
        </MudPaper>
    }

    @if (_topic.Items != null && _topic.Items.Any())
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudList T="string" Dense="true">
                @foreach (var item in _topic.Items)
                {
                    <MudListItem T="string">
                        <MudText Typo="Typo.body1">@item</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }

    @if (_topic.Sections != null)
    {
        @foreach (var section in _topic.Sections)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" Class="mb-2">@section.Title</MudText>
                @foreach (var line in section.Text.Split('\n'))
                {
                    <MudText Typo="Typo.body1">@line</MudText>
                }
            </MudPaper>
        }
    }

    @if (_topic.Verses != null && _topic.Verses.Any())
    {
        <MudText Typo="Typo.h6" Class="mb-2 mt-4">Weitere Bibelverse</MudText>
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            @foreach (var verse in _topic.Verses)
            {
                <MudText Typo="Typo.body1" Class="mb-2"><em>@verse</em></MudText>
            }
        </MudPaper>
    }

    @if (!string.IsNullOrEmpty(_topic.Image))
    {
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudImage Src="@_topic.Image" Alt="@_topic.ImageAlt" Fluid="true" ObjectFit="ObjectFit.Contain" Class="rounded-lg" />
            @if (!string.IsNullOrEmpty(_topic.ImageAlt))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@_topic.ImageAlt</MudText>
            }
        </MudPaper>
    }
}

@code {
    [Parameter]
    public string? CategoryId { get; set; }

    [Parameter]
    public string? TopicId { get; set; }

    private LearningCategory? _category;
    private LearningTopic? _topic;

    protected override async Task OnInitializedAsync()
    {
        var content = await ContentService.GetContentAsync();
        _category = content.Categories.FirstOrDefault(c => c.Id == CategoryId);
        _topic = _category?.Topics.FirstOrDefault(t => t.Id == TopicId);
    }
}
